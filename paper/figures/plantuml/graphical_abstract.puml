@startuml
!pragma layout smetana
skinparam dpi 300
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam ArrowColor #3B3B3B
skinparam ArrowThickness 1.4
skinparam rectangle {
  BorderColor #2D2D2D
  FontColor #111111
  RoundCorner 12
}

left to right direction

rectangle "Observations\nflight motion\nradio graph" as observations #E8F0FE
rectangle "Candidate predictors\ncurrent state | topology\nmotion | source gated" as predictors #FFF4DE
rectangle "Leakage controls\ntrain/validation selection\nlocked seeds" as controls #E6F4EA
rectangle "Warning output\nevent risk\nvalidated threshold" as warning #EADCF8
rectangle "Engineering tests\ndomain | packet\ncontroller | runtime" as tests #DDF2F2
rectangle "Evidence decision\nclaim boundary" as decision #FCE8E6
rectangle "Reproducible benchmark\nricher sources do not consistently beat the current-state comparator\nlocked paired tests | source factorial | domain transfer | packet/controller cost | measured host-side runtime" as summary #F5F5F5

observations --> predictors
predictors --> controls
controls --> warning
warning --> tests
tests --> decision
decision --> summary

@enduml
