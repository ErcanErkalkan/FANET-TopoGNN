@startuml
!pragma layout smetana
skinparam dpi 300
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam ArrowColor #3B3B3B
skinparam ArrowThickness 1.3
skinparam rectangle {
  BorderColor #2D2D2D
  FontColor #111111
  RoundCorner 12
}

left to right direction

rectangle "Compact config\nseeds 7, 17, 27\nN = 10, 20, 30" as config #E8F0FE
rectangle "Mobility simulation\nRWP, Gauss-Markov,\nmission traces" as mobility #E6F4EA
rectangle "Graph construction\nfixed/adaptive radius cap\nphysical radio: nominal/degraded" as graph #FFF4DE
rectangle "Feature extraction\nH0 MST persistence image\nkinetic and link-margin summaries" as features #EADCF8
rectangle "Leakage-safe split\ntrajectory groups stay\nwithin one fold" as split #F5F5F5
rectangle "Model evaluation\nKinetic-TopoGuard,\nbaselines and ablations" as eval #FCE8E6
rectangle "Artefact export\nCSV, LaTeX, JSON,\nHD figures and PDF" as export #DDF2F2

config -right-> mobility
mobility -right-> graph
graph -right-> features
features -down-> split
split -left-> eval
eval -left-> export

@enduml
