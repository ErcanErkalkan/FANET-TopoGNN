@startuml
!pragma layout smetana
skinparam dpi 300
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam ArrowColor #3B3B3B
skinparam ArrowThickness 1.3
skinparam rectangle {
  BorderColor #2D2D2D
  FontColor #111111
  RoundCorner 12
}

left to right direction

rectangle "Snapshot inputs\npositions x_t, velocities v_t\nphysical graph G_t" as input #E8F0FE
rectangle "Current-state anchor\nbeta_0(G_t)\ncomponent statistics" as anchor #FFF4DE
rectangle "Kinematic projection\nx_t + h v_t\nprojected link margins" as projection #E6F4EA
rectangle "H0 topology branch\npairwise distances + MST\n16 x 16 persistence image" as topology #EADCF8
rectangle "Feature vector phi(t)\nanchor + kinetic + topology + lags" as features #F5F5F5
rectangle "Residual beta regressor\nbeta_0(G_t) + delta_hat\nrounded beta forecast" as regressor #FCE8E6
rectangle "Calibrated risk scorer\nclassifier + residual + kinetic risk\nvalidation threshold" as risk #DDF2F2
rectangle "Controller interface\nbeta_hat, risk score\nrelay and routing decision" as controller #E9F5DB

input --> anchor
input --> projection
input --> topology
anchor --> features
projection --> features
topology --> features
features --> regressor
features --> risk
regressor --> controller
risk --> controller

@enduml
