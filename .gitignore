# Keep generated publication/manuscript outputs local by default.
outputs/*

# Keep Python bytecode out of source-control diffs.
__pycache__/
*.py[cod]

# Publish the compact manuscript-facing benchmark artefacts used for
# reproducibility and Zenodo archiving.
!outputs/q1_publication_compact/
!outputs/q1_publication_compact/**

# Keep transient rerun logs out of public release artefacts.
outputs/q1_publication_compact/*.log
outputs/q1_publication_compact/*started_at.txt
