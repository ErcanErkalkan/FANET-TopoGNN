# Track manuscript sources and release-facing PDFs.
# Ignore only transient LaTeX build artefacts.
paper/*.aux
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.spl
paper/*.synctex.gz

# Keep generated outputs local by default.
outputs/*

# Publish the compact manuscript-facing benchmark artefacts used for
# reproducibility and archiving.
!outputs/publication_compact/
!outputs/publication_compact/**

# Keep transient rerun logs out of public release artefacts.
outputs/publication_compact/**/*.log
outputs/publication_compact/**/*started_at.txt
outputs/publication_compact/**/*.tmp

# Keep Python bytecode out of source-control diffs.
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp*/
.pytest_*/
.pdf_qa/
tmp/
logs/

# Submission staging and audit reports are regenerated from current evidence.
anonymous_supplementary/
anonymous_supplementary.zip
.anonymous_supplementary_staging_*/
pre_submission_readiness_audit.json
submission_readiness_audit.json

# Large third-party external-validation downloads stay local.
data/external_validation/raw/

# Track the small derived trace, external-validation evidence, and confirmatory
# outputs while keeping all other exploratory outputs local.
!outputs/external_validation/
!outputs/external_validation/**
!outputs/aerpaw_cellular_validation/
!outputs/aerpaw_cellular_validation/**
!outputs/paper_like_submission/
!outputs/paper_like_submission/**
