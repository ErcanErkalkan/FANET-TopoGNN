{
  "experiment_name": "quickstart",
  "output_dir": "outputs/quickstart",
  "sim": {
    "area_size": 1000.0,
    "time_steps": 80,
    "dt": 0.1,
    "swarm_sizes": [10, 20],
    "runs_per_setting": 2,
    "mobility_models": ["rwp", "gm", "mission"],
    "base_radius": 300.0,
    "graph_policy": "adaptive",
    "link_model": "physical",
    "adaptive_scale": 1.6,
    "density_threshold": 0.00015,
    "split_seed": 2026,
    "split_stratify_by": ["mobility"],
    "speed_range": [10.0, 30.0],
    "gauss_markov_alpha": 0.8,
    "gauss_markov_mu": 20.0,
    "gauss_markov_sigma": 5.0,
    "mission_regions": 2,
    "mission_tracking_noise_m": 2.0,
    "mission_heading_noise_rad": 0.05,
    "mission_speed_jitter": 0.08,
    "physical_layer": {
      "path_loss_exponent": 2.7,
      "shadowing_sigma_db": 4.0,
      "nakagami_m": 1.0,
      "receiver_sensitivity_dbm": -92.0,
      "tx_power_dbm": 20.0,
      "tx_antenna_gain_dbi": 5.0,
      "rx_antenna_gain_dbi": 5.0,
      "system_loss_db": 2.0,
      "link_margin_db": 10.0,
      "chain_asymmetry_sigma_db": 1.0,
      "apply_radius_cap": true,
      "tx_probability": 0.35,
      "noise_floor_dbm": -101.0,
      "sinr_threshold_db": 8.0
    },
    "pi_resolution": 20,
    "pi_sigma": 20.0,
    "pi_max_radius": 600.0,
    "forecast_horizon_steps": 6
  },
  "training": {
    "seed_list": [7, 17, 27],
    "epochs": 16,
    "patience": 4,
    "batch_size": 32,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "hidden_dim": 64,
    "dropout": 0.15,
    "temporal_windows": [3, 5]
  },
  "evaluation": {
    "bootstrap_rounds": 200,
    "network_radius_boost": 1.15,
    "warning_horizon_steps": 6,
    "risk_threshold": 0.5
  }
}
