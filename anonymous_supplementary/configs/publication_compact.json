      "kinetic_topoguard",
      "GCN",
      "GAT",
      "GraphSAGE",
      "PI+MLP",
      "FANET-TopoGNN",
      "FANET-TopoGNN (concat)",
      "tgcn:5",
      "stgcn:5",
      "tgn:5"
    ]
  },
  "evaluation": {
    "bootstrap_rounds": 200,
    "network_radius_boost": 1.15,
    "warning_horizon_steps": 6,
    "risk_threshold": 0.5
